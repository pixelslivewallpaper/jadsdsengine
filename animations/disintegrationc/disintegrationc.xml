<?xml version="1.0"?>
<doc>
  <basic type="animations">
    <screenCanvasResolution>
      <width>110</width>
      <height>110</height>
    </screenCanvasResolution>
    <canvasResolution>
      <maxWidth>110</maxWidth>
      <maxHeight>110</maxHeight>
    </canvasResolution>
    <bgColor>#ffcccccc</bgColor>
  </basic>
  <images>
    <image>
      <fileName>back.png</fileName>
      <left>0</left>
      <top>0</top>
    </image>
    <image>
      <fileName>boss.png</fileName>
      <left>10</left>
      <top>10</top>
      <id>boss</id>
      <moveAnimation>
        <iniTop>10</iniTop>
        <maxTop>100</maxTop>
        <pixelsMoveTop>1</pixelsMoveTop>
        <moveAnimationStop>true</moveAnimationStop>
        <moveAnimationSpeed>3</moveAnimationSpeed>
      </moveAnimation>
      <applyAlterations>
        <postEffects>
          <effect>
            <effectName frameByFrame="true">Disintegration</effectName>
            <!-- <addShake>true</addShake> -->
            <shakeIntensity>1</shakeIntensity>
            <!-- <dissolveHeight>40</dissolveHeight> -->
            <speed>100</speed>
            <!-- <startAnimation>false</startAnimation> -->
            <checkForProgressEvents>true</checkForProgressEvents>
            <!-- <allImage>true</allImage> -->
            <!-- <gradientNoise>1</gradientNoise> -->
            <!-- <dissolveProgress>40</dissolveProgress> -->
          </effect>
        </postEffects>
      </applyAlterations>
      <imagePropertiesAnimation>
        <propetiesToAnimate>
          <property>
            <propertyName>Alpha</propertyName>
            <minimumAlphaValue>0</minimumAlphaValue>
            <maximumAlphaValue>255</maximumAlphaValue>
            <updateAlphaValue>0</updateAlphaValue>
            <currentAlphaValue>255</currentAlphaValue>
            <animationAlphaAction>Decrease</animationAlphaAction>
            <alphaSpeed>1</alphaSpeed>
          </property>
        </propetiesToAnimate>
      </imagePropertiesAnimation>
      <events>
        <event>
          <eventType>OnClickDown</eventType>
          <eventActions>
            <eventAction>PostEffectDisintegrationStop</eventAction>
          </eventActions>
          <ids>boss</ids>
        </event>
        <event>
          <eventType>PostEffectDisintegrationReached</eventType>
          <eventActions>
            <eventAction>EditAnimationByID</eventAction>
          </eventActions>
          <whenDisintegrationProgressIs>70-75</whenDisintegrationProgressIs>
          <editAnimationByIDOptions>
            <option>
              <imageID>boss</imageID>
              <editActions>
                <editAction>UpdateImagePropertiesAnimation</editAction>
              </editActions>
              <newImagePropertiesAnimation>
                <propetiesToAnimate>
                  <property>
                    <propertyName>Alpha</propertyName>
                    <minimumAlphaValue>0</minimumAlphaValue>
                    <maximumAlphaValue>255</maximumAlphaValue>
                    <updateAlphaValue>4</updateAlphaValue>
                    <currentAlphaValue>255</currentAlphaValue>
                    <animationAlphaAction>Decrease</animationAlphaAction>
                    <alphaSpeed>1</alphaSpeed>
                  </property>
                  </propetiesToAnimate>
              </newImagePropertiesAnimation>
            </option>
          </editAnimationByIDOptions>
        </event>
        <event>
          <eventType>MoveAnimationMaxBottomReached</eventType>
          <eventActions>
            <eventAction>StopMove</eventAction>
          </eventActions>
        </event>
        <event>
          <eventType>PostEffectDisintegrationReached</eventType>
          <eventActions>
            <eventAction>ResumeMove</eventAction>
          </eventActions>
          <whenDisintegrationProgressIs>30-35</whenDisintegrationProgressIs>
        </event>
        <event>
          <eventType>PostEffectDisintegrationReached</eventType>
          <eventActions>
            <eventAction>PostEffectDisintegrationShake</eventAction>
          </eventActions>
          <whenDisintegrationProgressIs>75-80</whenDisintegrationProgressIs>
        </event>
      </events>
    </image>
  </images>
</doc>

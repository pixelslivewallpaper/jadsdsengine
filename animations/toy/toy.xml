<?xml version="1.0"?>
<doc>
  <basic type="animations">
    <screenCanvasResolution>
      <width>768</width>
      <height>224</height>
    </screenCanvasResolution>
    <canvasResolution>
      <maxWidth>768</maxWidth>
      <maxHeight>224</maxHeight>
    </canvasResolution>
    <bgColor>#ffffffff</bgColor>
  </basic>
  <javaScriptActions>
    <javaScriptAction>
      <id>more</id>
      <events>
        <event>
          <eventActions>
            <eventAction>ChangeAnimationAlphaAction</eventAction>
          </eventActions>
          <animationAlphaAction>Increase</animationAlphaAction>
          <ids>cover</ids>
        </event>
      </events>
    </javaScriptAction>
    <javaScriptAction>
      <id>less</id>
      <events>
        <event>
          <eventActions>
            <eventAction>ChangeAnimationAlphaAction</eventAction>
          </eventActions>
          <animationAlphaAction>Decrease</animationAlphaAction>
          <ids>cover</ids>
        </event>
      </events>
    </javaScriptAction>
  </javaScriptActions>
  <images>
    <image>
      <fileName>back.png</fileName>
      <left>256</left>
      <top>0</top>
    </image>
    <image>
      <fileName>wall.png</fileName>
      <moveEndLessAnimation>
        <direction>Backward</direction>
        <pixelsMove>2</pixelsMove>
      </moveEndLessAnimation>
      <left>256</left>
      <top>-28</top>
    </image>
    <image>
      <fileName>ff.png</fileName>
      <applyAlterations>
        <postEffects>
          <effect>
            <effectName frameByFrame="true">Distortion</effectName>
            <distortionType>Skew</distortionType>
            <fillOffPixels>false</fillOffPixels>
            <valueToSkew>-4.8</valueToSkew>
            <dynamicValueToSkew>0.1</dynamicValueToSkew>
            <maxValueToSkew>0</maxValueToSkew>
            <minValueToSkew>-4.9</minValueToSkew>

          </effect>
        </postEffects>
      </applyAlterations>
      <moveAnimation>
        <iniLeft>-1000</iniLeft>
        <maxLeft>1000</maxLeft>
        <pixelsMoveLeft>-4</pixelsMoveLeft>
        <pixelsMoveTop>0</pixelsMoveTop>
      </moveAnimation>
      <events>
        <event>
          <eventType>PostEffectSkewMaxReached</eventType>
          <eventActions>
            <eventAction>EditPosition</eventAction>
          </eventActions>
          <newCoordinates>392;176</newCoordinates>
        </event>
      </events>
      <top>176</top>
      <left>392</left>
    </image>
    <image>
      <fileName>ff.png</fileName>
      <applyAlterations>
        <postEffects>
          <effect>
            <effectName frameByFrame="true">Distortion</effectName>
            <distortionType>Skew</distortionType>
            <fillOffPixels>false</fillOffPixels>
            <valueToSkew>0</valueToSkew>
            <dynamicValueToSkew>0.1</dynamicValueToSkew>
            <maxValueToSkew>4.8</maxValueToSkew>
            <minValueToSkew>0</minValueToSkew>
            <returnToDefaultValue>true</returnToDefaultValue>
          </effect>
        </postEffects>
      </applyAlterations>
      <moveAnimation>
        <iniLeft>-1000</iniLeft>
        <maxLeft>1000</maxLeft>
        <pixelsMoveLeft>-4</pixelsMoveLeft>
        <pixelsMoveTop>0</pixelsMoveTop>
      </moveAnimation>
      <events>
        <event>
          <eventType>PostEffectSkewMaxReached</eventType>
          <eventActions>
            <eventAction>EditPosition</eventAction>
          </eventActions>
          <newCoordinates>200;176</newCoordinates>
        </event>
      </events>
      <top>176</top>
      <left>200</left>
    </image>
    <image>
      <fileName>bb.png</fileName>
      <id>cover</id>
      <imagePropertiesAnimation>
        <propetiesToAnimate>
          <property>
            <propertyName>Alpha</propertyName>
            <minimumAlphaValue>100</minimumAlphaValue>
            <maximumAlphaValue>255</maximumAlphaValue>
            <updateAlphaValue>40</updateAlphaValue>
            <currentAlphaValue>255</currentAlphaValue>
            <animationAlphaAction>Increase</animationAlphaAction>
            <alphaSpeed>6</alphaSpeed>
          </property>
        </propetiesToAnimate>
      </imagePropertiesAnimation>
      <left>0</left>
      <top>0</top>
    </image>
  </images>

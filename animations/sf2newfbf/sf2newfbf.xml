      <!--<align>Custom</align>
      <customAlignLeft>-500</customAlignLeft>
      <customAlignTop>100</customAlignTop>-->

      <autoHorizontalScroll>true</autoHorizontalScroll>
      <iniPosition>0.5;0</iniPosition>
      <pixelsMove>1</pixelsMove>
      <cameraSpeed>1</cameraSpeed>

      <events>
        <event>
          <eventType>MoveAnimationMaxLeftReached</eventType>
          <eventActions>
            <eventAction>PostEffectSkewPlay</eventAction>
          </eventActions>
          <newDynamicValueToSkew>-0.1</newDynamicValueToSkew>
          <ids>floor</ids>
        </event>
        <event>
          <eventType>MoveAnimationMaxRightReached</eventType>
          <eventActions>
            <eventAction>PostEffectSkewPlay</eventAction>
          </eventActions>
          <newDynamicValueToSkew>0.1</newDynamicValueToSkew>
          <ids>floor</ids>
        </event>
        <event>
          <eventType>MoveStopped</eventType>
          <eventActions>
            <eventAction>PostEffectSkewStop</eventAction>
          </eventActions>
          <ids>floor</ids>
        </event>
        <event>
          <eventType>MoveResumed</eventType>
          <eventActions>
            <eventAction>PostEffectSkewPlay</eventAction>
          </eventActions>
          <ids>floor</ids>
        </event>
      </events>
    </camera>
